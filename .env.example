# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# LƯU Ý GIỜ GIẤC: mọi mốc giờ bên dưới tính theo GIỜ MÁY đang chạy (giả định = giờ
# nghiệp vụ Việt Nam). Đài Loan lệch +1h — nếu chạy trên máy múi giờ khác phải chỉnh.

# --- Track A: dashboard vận đơn ---
SEVEN_ELEVEN_URL=https://myship.7-11.com.tw/seller/order
SEVEN_ELEVEN_USER=
SEVEN_ELEVEN_PASS=
# Đường dẫn Playwright storage_state (session đã login)
SEVEN_ELEVEN_STORAGE_STATE=.auth/711_state.json
# Lần chạy đầu để false để login tay (CAPTCHA), sau đó true
HEADLESS=true

# --- Backend báo đơn (bao-don-flow.md §3) ---
# Bao lâu quét dashboard một lần (phút)
SCAN_INTERVAL_MINUTES=15
# Các mốc nhắc lại đơn cũ trong ngày (HH:MM, phân cách bằng dấu phẩy)
REMIND_TIMES=09:00,14:00
# Nhắc tối đa bao nhiêu ngày rồi đẩy sang sổ ngoại lệ
REMIND_MAX_DAYS=7
# Không nhắn Sale trong khung này (cho phép qua nửa đêm)
QUIET_HOURS=21:00-07:00
# Giãn nhịp gửi, tránh bị coi là spam (tin/phút)
NOTIFY_RATE_PER_MIN=10
# File SQLite lưu trạng thái đơn (không commit)
BAODON_DB_PATH=data/baodon.db
